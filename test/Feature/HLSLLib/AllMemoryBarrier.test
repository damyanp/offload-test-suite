#--- source.hlsl

RWStructuredBuffer<uint> DevicePayload : register(u0);
RWStructuredBuffer<uint> Flag : register(u1);
RWStructuredBuffer<uint> Out : register(u2);

groupshared uint GroupPayload[319];

[numthreads(319, 1, 1)]
void main(uint3 GTID : SV_GroupThreadID) {
  uint TID = GTID.x;
  uint WindowBase = (TID / 13u) * 13u;
  uint WindowSize = min(13u, 319u - WindowBase);
  uint Other = WindowBase + ((TID + 5u) % WindowSize);
  uint Faults = 0u;
  GroupPayload[TID] = 0u;
  DevicePayload[TID] = 0u;
  Flag[TID] = 0u;

  AllMemoryBarrierWithGroupSync();

  // Start each update after all threads complete the prior update.
  for (uint Update = 1u; Update < 65u; ++Update) {
    AllMemoryBarrierWithGroupSync();

    GroupPayload[TID] = Update;
    DevicePayload[TID] = Update;

    // Complete both payload updates before this thread sets its flag.
    AllMemoryBarrier();

    Flag[TID] = Update;

    // Read one thread in this window many times. Some windows cross waves.
    for (uint Check = 0u; Check < 33u; ++Check) {
      uint OtherFlag = Flag[Other];

      // Complete the flag read before this thread reads both payloads.
      AllMemoryBarrier();

      uint OtherGroupPayload = GroupPayload[Other];
      uint OtherDevicePayload = DevicePayload[Other];
      if (OtherFlag == Update &&
          (OtherGroupPayload != Update || OtherDevicePayload != Update))
        ++Faults;
      if ((OtherGroupPayload == Update - 1u ||
           OtherDevicePayload == Update - 1u) &&
          OtherFlag != Update - 1u)
        ++Faults;

      AllMemoryBarrier();
    }
  }

  Out[TID] = Faults;
}

//--- pipeline.yaml
---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: DevicePayload
    Format: UInt32
    Stride: 4
    FillSize: 1276
  - Name: Flag
    Format: UInt32
    Stride: 4
    FillSize: 1276
  - Name: Out
    Format: UInt32
    Stride: 4
    FillSize: 1276
  - Name: ExpectedOut
    Format: UInt32
    Stride: 4
    FillSize: 1276
Results:
  - Result: AllMemoryBarrier
    Rule: BufferExact
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: DevicePayload
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Flag
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
...
#--- end

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
