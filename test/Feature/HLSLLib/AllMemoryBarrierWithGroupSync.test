#--- source.hlsl

RWStructuredBuffer<uint> Data : register(u0);
RWStructuredBuffer<uint> Out : register(u1);

groupshared uint GroupPayload;

[numthreads(512, 1, 1)]
void main(uint3 GTID : SV_GroupThreadID) {
  if (GTID.x == 511) {
    GroupPayload = 1u;
    Data[0] = 1u;
  }

  // Wait until all threads can read both first values.
  AllMemoryBarrierWithGroupSync();

  if (GTID.x == 0) {
    Out[0] = GroupPayload;
    Out[1] = Data[0];
  }

  // Wait until thread 0 reads both first values.
  AllMemoryBarrierWithGroupSync();

  // Each loop step has one writer. The barrier completes both writes before
  // the next step.
  for (uint I = 0; I < 512; ++I) {
    if (GTID.x == I) {
      GroupPayload = GroupPayload + 1u;
      Data[0] = Data[0] + 1u;
    }

    AllMemoryBarrierWithGroupSync();
  }

  // The results are correct only if all 512 writes are complete.
  if (GTID.x == 256) {
    Out[2] = GroupPayload;
    Out[3] = Data[0];
  }
}

//--- pipeline.yaml
---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: Data
    Format: UInt32
    Stride: 4
    Data: [ 0 ]
  - Name: Out
    Format: UInt32
    Stride: 4
    FillSize: 16
  - Name: ExpectedOut
    Format: UInt32
    Stride: 4
    Data: [ 1, 1, 513, 513 ]
Results:
  - Result: AllMemoryBarrierWithGroupSync
    Rule: BufferExact
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: Data
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
