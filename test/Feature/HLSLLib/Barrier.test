#--- source.hlsl

RWStructuredBuffer<uint> Data : register(u0);
RWStructuredBuffer<uint> Out : register(u1);

[numthreads(512, 1, 1)]
void main(uint3 GTID : SV_GroupThreadID) {
  if (GTID.x == 511)
    Data[0] = 1u;

  // Wait until all threads in the group can read the first value.
  Barrier(UAV_MEMORY, GROUP_SCOPE | GROUP_SYNC);

  if (GTID.x == 0)
    Out[0] = Data[0];

  // Wait until thread 0 reads the first value.
  Barrier(UAV_MEMORY, GROUP_SCOPE | GROUP_SYNC);

  // Each loop step has one writer. The barrier completes the write before
  // the next step.
  for (uint I = 0; I < 512; ++I) {
    if (GTID.x == I)
      Data[0] = Data[0] + 1u;

    Barrier(UAV_MEMORY, GROUP_SCOPE | GROUP_SYNC);
  }

  // The result is correct only if all 512 writes are complete.
  if (GTID.x == 256)
    Out[1] = Data[0];
}

//--- pipeline.yaml
---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: Data
    Format: UInt32
    Stride: 4
    Data: [ 0 ]
  - Name: Out
    Format: UInt32
    Stride: 4
    FillSize: 8
  - Name: ExpectedOut
    Format: UInt32
    Stride: 4
    Data: [ 1, 513 ]
Results:
  - Result: Barrier
    Rule: BufferExact
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: Data
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# Clang does not implement Barrier: https://github.com/llvm/llvm-project/issues/99234
# UNSUPPORTED: Clang

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_8 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
